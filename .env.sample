# Supabase project (Settings > API). Local stack: printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# RevenueCat public Web Billing key (project "Storybook AI web")
NEXT_PUBLIC_REVENUECAT_API_KEY=

# Test harness only (bun run test:story). The Edge Functions read these from
# `supabase secrets set` instead: OPENAI_API_KEY, REVENUECAT_SECRET_KEY, REVENUECAT_PROJECT_ID.
OPENAI_API_KEY=

# Public origin for absolute OpenGraph URLs, e.g. https://storybook.example.com
NEXT_PUBLIC_SITE_URL=
